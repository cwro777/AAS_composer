                          "verified": "spec",
                          "required": true,
                          "cardinality": "1",
                          "valueType": "xs:string",
                          "exampleValue": "opc.tcp://10.0.1.20:4840"
                        },
                        {
                          "t": "prop",
                          "idShort": "contentType",
                          "semanticId": "https://www.w3.org/2019/wot/hypermedia#forContentType",
