# apps/api
PORT=8787
# 이 PC의 5432는 다른 스택이 쓰고 있어 5433으로 비켜 둔다 (docker-compose.yml 참조)
DATABASE_URL=postgres://aas:aas@localhost:5433/aas

# BaSyx V2 (AAS V3 API) — docker-compose 기준
BASYX_URL=http://localhost:8081

# 사전 프록시 — IEC CDD 단독 (eCl@ss 라이선스 없음)
CDD_BASE_URL=https://cdd.iec.ch

# 자체 발행 IRI의 뿌리. 전역 식별자가 이것으로 시작하는지 검사한다(POL-IRI-001).
# 회사 도메인으로 바꾸십시오. 에디터에서도 바꿀 수 있지만 이 값이 기본이 된다.
IRI_PREFIX=https://cw1.co.kr/ids

# apps/web — 웹도 이 파일을 읽는다(apps/web/next.config.ts). 바꾸면 web·api를 다시 띄운다.
NEXT_PUBLIC_API_URL=http://localhost:8787
# 위 IRI_PREFIX와 **같아야 한다**. 다르면 에디터와 서버의 검증 결과가 갈린다.
NEXT_PUBLIC_IRI_PREFIX=https://cw1.co.kr/ids
